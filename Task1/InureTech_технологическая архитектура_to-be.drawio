        <mxCell id="vb4KFq06RkEf4j8th982-81" value="&lt;span style=&quot;font-size: 15px;&quot;&gt;Active Failover&lt;/span&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="vb4KFq06RkEf4j8th982-79">
