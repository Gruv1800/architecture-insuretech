          <mxGeometry x="760" y="565" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="JS7NZMJ-O14xZmiOas5a-63" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e51400;fontColor=#ffffff;strokeColor=#B20000;" vertex="1" parent="1">
          <mxGeometry x="770" y="685" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="JS7NZMJ-O14xZmiOas5a-64" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e51400;fontColor=#ffffff;strokeColor=#B20000;" vertex="1" parent="1">
          <mxGeometry x="1010" y="745" width="20" height="20" as="geometry" />
